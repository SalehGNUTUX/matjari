{
  "name": "matjari-pos",
  "version": "2.0.0",
  "description": "نظام إدارة المبيعات الذكي - Smart POS for Small Business",
  "main": "main.js",
  "author": {
    "name": "Saleh GNUTUX",
    "email": "saleh@gnutux.com",
    "url": "https://github.com/SalehGNUTUX"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/SalehGNUTUX/matjari"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit --skipLibCheck && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "_comment_linux": "=== Linux AppImage ===",
    "package:linux": "npm run build:web && electron-builder --linux AppImage",
    "package:linux:deb": "npm run build:web && electron-builder --linux deb",
    "package:linux:rpm": "npm run build:web && electron-builder --linux rpm",
    "_comment_win": "=== Windows ===",
    "package:win": "npm run build:web && electron-builder --win nsis",
    "package:win:portable": "npm run build:web && electron-builder --win portable",
    "_comment_android": "=== Android APK ===",
    "android:build": "npm run build:web && npx cap sync android && npx cap build android",
    "android:open": "npm run build:web && npx cap sync android && npx cap open android",
    "android:run": "npm run build:web && npx cap sync android && npx cap run android",
    "_comment_all": "=== All platforms ===",
    "package:all": "npm run build:web && electron-builder --linux AppImage --win portable",
    "clean": "rimraf dist dist_electron android/app/src/main/assets/public",
    "generate-icons": "node scripts/generate-android-icons.js"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.344.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.2",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.9.0",
    "postcss": "^8.4.35",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.matjari.pos",
    "productName": "Matjari",
    "copyright": "Copyright © 2024 Saleh GNUTUX - GPL-3.0",
    "directories": {
      "output": "dist_electron",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "public/icon.png",
      "public/icon.ico",
      "public/icon.icns",
      "public/fonts/**/*"
    ],
    "extraResources": [
      {
        "from": "public/fonts",
        "to": "fonts"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "public/icon.png",
      "desktop": {
        "Name": "Matjari | متجري",
        "GenericName": "POS System",
        "Comment": "نظام إدارة المبيعات الذكي",
        "Categories": "Office;Finance;",
        "StartupWMClass": "Matjari",
        "Keywords": "POS;Sales;متجري;مبيعات"
      },
      "artifactName": "Matjari-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "appImage": {
      "artifactName": "Matjari-${version}-${arch}.AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Matjari POS",
      "artifactName": "Matjari-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Matjari-${version}-Portable.exe",
      "requestExecutionLevel": "user"
    }
  }
}